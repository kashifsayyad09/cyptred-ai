# ============================================================
# AI Exam Guardian — Environment Variables Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_STRONG_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Database (AWS RDS MySQL) ---
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=exam_guardian
DB_USER=exam_guardian_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Groq (PRIMARY AI Provider) ---
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# --- NVIDIA NIM (FALLBACK AI Provider) ---
NVIDIA_API_KEY=CHANGE_ME_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama3-8b-instruct
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=2

# --- MCP Server ---
MCP_HOST=mcp
MCP_PORT=8001
MCP_SECRET=CHANGE_ME_MCP_INTERNAL_SECRET

# --- RAG Engine ---
RAG_HOST=rag
RAG_PORT=8002
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_VECTOR_STORE_PATH=/app/rag/vectorstore
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# --- Frontend ---
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
# NOTE: Never add GROQ or NVIDIA keys here. Frontend must never see AI keys.

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=ai-exam-guardian

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Risk Engine (all weights configurable) ---
RISK_WEIGHT_TAB_SWITCH=10
RISK_WEIGHT_FOCUS_LOSS=5
RISK_WEIGHT_COPY=15
RISK_WEIGHT_PASTE=15
RISK_WEIGHT_FULLSCREEN_EXIT=10
RISK_WEIGHT_SUSPICIOUS_NAVIGATION=20
RISK_WEIGHT_AI_ASSISTANT_SIGNAL=25
RISK_WEIGHT_REPEATED_VIOLATIONS=20
RISK_WEIGHT_SUSPICIOUS_SEQUENCE=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
